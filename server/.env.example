# Скопируйте в .env и укажите пароль пользователя PostgreSQL (не номер порта!)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=restaurant_db
PGPASSWORD=ваш_пароль_postgres
PGPORT=5432
PORT=5000
JWT_SECRET=change_me_in_production

# Почта для уведомлений об отзывах
REVIEWS_NOTIFY_EMAIL=zaharov_a_v_2002@mail.ru

# SMTP для отправки писем (Mail.ru: smtp.mail.ru, порт 465, пароль приложения)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=ваш_ящик@mail.ru
SMTP_PASS=пароль_приложения
SMTP_FROM="Прованс" <ваш_ящик@mail.ru>
